---
import { characters, crawlerInfo, physicalTraits } from "../const/characters";
import svgTop from "../assets/layered-peaks-top2.svg";
import svgBottom from "../assets/layered-peaks-bottom2.svg";

const DESKTOP_ROW_PATTERN = [3, 3, 3];
// aquí guardaremos personajes con posición
const positionedCharacters: any[] = [];
let currentIndex = 0;

DESKTOP_ROW_PATTERN.forEach((cols, rowIndex) => {
  // recorrer columnas de esa fila
  for (let col = 1; col <= cols; col++) {
    // si ya no quedan personajes, parar
    if (currentIndex >= characters.length) break;

    // guardar personaje con row y col
    positionedCharacters.push({
      ...characters[currentIndex],

      row: rowIndex + 1,

      // escalera invertida
      col: col,
    });

    // siguiente personaje
    currentIndex++;
  }
});
---

<section
  class="character"
  style={`--svg-top: url(${svgTop.src}); --svg-bottom: url(${svgBottom.src});`}
>
  <div class="character-container section">
    <div class="selection-character">
      <div class="selection-title">
        <h2 style="text-align: start;">
          Character
          <span>SELECTION</span>
        </h2>
      </div>
      <div class="character-grid-selection">
        {
          positionedCharacters.map((character) => {
            return (
              <div
                class="character-card"
                style={`grid-column: ${character.col}; grid-row: ${character.row};`}
                data-id={character.id}
              >
                <div class="img-wrap">
                  <picture>
                    <source
                      srcset={`${character.selection_img}.avif`}
                      type="image/avif"
                    />
                    <source
                      srcset={`${character.selection_img}.webp`}
                      type="image/webp"
                    />
                    <img
                      src={`${character.selection_img}.png`}
                      loading="lazy"
                      alt={character.name}
                    />
                  </picture>
                </div>

                <div class="character-name">
                  <span>{character.name}</span>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
    <div class="info-character">
      <div class="character-main">
        <div class="character-bg">
          <div class="character-stats" id="crawler_stats">
