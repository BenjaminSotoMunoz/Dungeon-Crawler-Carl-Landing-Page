                <div class="category-info">
                  <h4 class="stats-title">CRAWLER #</h4>
                  <p class="info" data-key="id_character">4.119</p>
                </div>
              </div>
            </div>
            <div class="character-description">
              <h4 class="stats-title">ABOUT CARL</h4>
              <p class="info" data-key="desc_character">
                Carl is the titular protagonist of Dungeon Crawler Carl. A
                former coast guardsman, Carl and his ex-girlfriend's cat are now
                fan-favorite crawlers on the Syndicate gameshow, Dungeon Crawler
                World: Earth.
              </p>
            </div>
          </div>
          <div class="character-image">
            <img src="/character/maggie.avif" alt="" loading="lazy" />
          </div>
