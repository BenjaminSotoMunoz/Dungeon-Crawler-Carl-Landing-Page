      </div>
      <style>
        h2 {
          animation: breathe ease forwards;
          animation-timeline: --section;
          animation-range: entry 40%;
        }
        .selection-title h2 {
          font-family: "Bebas Neue", sans-serif;
          font-size: var(--font-size-title);
          line-height: 0.9;
          font-weight: 900;
          text-transform: uppercase;
          color: #fff;
        }

        .selection-title h2 span {
          display: block;
          padding-left: 5rem;
          color: #00000000;
          -webkit-text-stroke: 2px #c90f4d;
        }

        .character {
          position: relative;
          display: flex;
          justify-content: center;
          align-items: center;
          height: 100vh;
          overflow: hidden;
          z-index: 1;
        }

        .character-info-name {
          font-family: "Bebas Neue", sans-serif;
          grid-column: 1/4;
          grid-row: 1;
          display: flex;
          flex-direction: column;
          justify-content: center;
          line-height: 0.9;
        }

        .character-info-name .section-title {
          font-size: var(--font-size-subtitle);
          text-transform: uppercase;
          color: #fff;
          font-weight: 900;
        }

        .character-info-name span {
          display: block;
          color: #d40856ef;
          font-size: var(--font-size-glow);
          font-weight: 900;
        }

        .character-info {
          position: relative;
          grid-column: 1/4;
          grid-row: 2/4;
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 0.5rem;
          background: #1a080f57;
          height: 100%;
          backdrop-filter: blur(14px);
          -webkit-backdrop-filter: blur(14px);
          border: 2px solid #d4085688;
          max-width: 350px;
          border-radius: 10px;
        }

        .info {
          font-size: var(--font-size-text);
          color: #e0e0e0;
        }

        .stats-title {
          font-size: var(--font-size-glow);
          font-weight: 900;
          color: #d40856ef;
        }

        .character::before {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 300px;
          background-image: var(--svg-top);
          background-repeat: no-repeat;
          background-position: top;
          background-size: cover;
          filter: drop-shadow(0 2px 10px rgb(1, 1, 1));
          pointer-events: none;
          z-index: 10;
        }

        .character::after {
          content: "";
          position: absolute;
          bottom: 0;
          left: 0;
          width: 100%;
          height: 50%;
          background-image: var(--svg-bottom);
          background-repeat: no-repeat;
          background-position: bottom;
          background-size: cover;
          filter: drop-shadow(0 2px 10px rgb(1, 1, 1));
          pointer-events: none;
          z-index: 10;
        }

        .character-description {
          font-family: "Bebas Neue", sans-serif;
          grid-column: 1/4;
          grid-row: 4/6;
          padding: 1rem;
          border: 2px solid #bb004b7a;
          background-color: #1a080f57;
          border-radius: 0.75rem;
          max-width: 350px;
          height: max-content;
          backdrop-filter: blur(14px);
          -webkit-backdrop-filter: blur(14px);
        }

        .character-description .info {
          line-height: 1.6;
        }

        .character-description .stats-title {
          margin-bottom: 0.5rem;
        }

        .character-container {
          display: grid;
          grid-template-columns: 42% 58%;
          min-height: 100vh;
          gap: 2rem;
          border: 3px solid #bb004b81;
          background-color: #bb004b09;
          width: 1600px;
          margin: 2rem auto;
          align-items: center;
          transform: skew(-3deg);
        }

        .selection-character {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          /* height: 80%; */
          width: 100%;
          gap: 2rem;
          padding: 1.5rem;
          opacity: 0;
          animation: slideA ease forwards;
          animation-timeline: --section;
          animation-range: entry 40%;
        }

        .info-character {
          display: flex;
          flex-direction: column;
          gap: 1rem;
          justify-content: center;
          align-items: center;
          position: relative;
          /* height: max-content;R */
          height: 80vh;
          opacity: 0;
          animation: slideB ease forwards;
          animation-timeline: --section;
          animation-range: entry 40%;
        }

        .character-origin {
          font-family: "Bebas Neue", sans-serif;
          font-weight: 600;
          display: flex;
          height: 100%;
          max-width: 350px;
          border-bottom: 2px solid #d4085688;
          padding: 0.5rem;
        }

        .character-origin:last-child {
          border-bottom: none;
        }

        .character-origin .icon {
          height: 100%;
          padding: 0 1rem;
          display: flex;
          align-items: center;
        }

        svg {
          height: 40px;
          width: 40px;
        }

        .category-info {
          display: flex;
          flex-direction: column;
          height: 100%;
          justify-content: center;
        }

        .character-main {
          position: relative;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          width: 100%;
          height: 100%;
        }

        .character-main::before {
          content: "";
          position: absolute;
          width: 100%;
          min-height: 100vh;
          border-left: 3px solid #bb004b81;
        }

        .character-bg {
          position: relative;
          display: grid;
          grid-template-columns: repeat(9, 1fr);
          grid-template-rows: repeat(3, 1fr);
          justify-content: center;
          align-items: center;
          padding: 1.5rem;
          width: 95%;
          height: 100%;
        }

        .character-image::after {
          content: "";
          position: absolute;
          inset: 0;
          background-image: url("/books/paint.png");
          background-size: contain;
          background-repeat: no-repeat;
          background-position: center;
          width: 100%;
          height: 100%;
          z-index: -1;
        }

        .character-image {
          position: relative;
          grid-column: 4/10;
          grid-row: 1/4;
          height: 100%;
          transform: scale(1.15);
          display: flex;
          justify-content: center;
          margin-right: 1rem;
          z-index: -10;
        }

        .character-stats {
          grid-column: 1/6;
          grid-row: 1/4;
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          grid-template-rows: repeat(5, 1fr);
          height: 100%;
          /* transform: skew(-3deg); */
          margin-left: 2rem;
          gap: 1rem;
        }

        .character-image img {
          filter: drop-shadow(10px 2px 0px #bb004b);
          height: 100%;
          object-position: right;
          object-fit: contain;
          transition:
            opacity 0.35s ease,
            transform 0.35s ease;
          opacity: 1;
        }

        .stat-container {
          position: absolute;
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          grid-template-rows: repeat(3, 1fr);
          gap: 1rem;
          width: 100%;
          height: 90%;
          margin-top: 2rem;
        }

        .stat-card {
          background: rgb(17, 15, 15);
          font-family: "Inter", sans-serif;

          border: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 0px 0px 18px 18px;
          padding: 1rem 1.2rem;
          backdrop-filter: blur(10px);
          box-shadow: 0px 0px 13px 3px rgb(4 4 4 / 99%);
          transition:
            transform 0.3s ease,
            border-color 0.3s ease;

          overflow: hidden;
        }

        .stat-card:nth-child(1) {
          grid-column: 1;
          grid-row: 1;
        }

        .stat-card:nth-child(2) {
          grid-column: 3;
          grid-row: 2;
        }
        .stat-card:nth-child(3) {
          grid-column: 1;
          grid-row: 3;
        }
        .stat-card:nth-child(4) {
          grid-column: 3;
          grid-row: 1;
        }

        .character-grid-selection {
          display: grid;
          grid-template-columns: repeat(3, 150px);
          grid-template-rows: repeat(3, 170px);
          gap: 0.5rem;
          /* transform: skew(-3deg); */
        }

        .character-card {
          position: relative;
          display: flex;
          flex-direction: column;
          background-color: #1d161981;
          border: 1px solid rgba(54, 52, 52, 0.856);
          border-radius: 12px;
          transition:
            transform 0.3s ease,
            border-color 0.3s ease;
          overflow: hidden;
          cursor: pointer;
          z-index: 10;
        }

        .character-card::after {
          content: "";
          position: absolute;
          inset: -4px;
          background: #e22356;
          filter: blur(7px);
          opacity: 0;
          transition: opacity 0.25s ease;
          z-index: -1;
        }

        .character-card.active::after,
        .character-card:hover::after {
          opacity: 1;
        }

        .character-card:hover {
          transform: translateY(-4px);
        }

        .character-card img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: top;
          pointer-events: none;
          transform: translateZ(0);
          backface-visibility: hidden;
        }

        .character-name {
          color: #f2f2f2;
          padding: 0.5rem 0;
          font-family: "Inter", sans-serif;
          font-weight: 600;
          height: 32px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(0, 0, 0, 0.9);
          backdrop-filter: blur(6px);
          box-shadow: 0px 0px 8px 6px rgb(0 0 0 / 75%);
          pointer-events: none;
        }

        .character-desc p,
        .character-main .title-section,
        .info {
          transition:
            opacity 0.25s ease,
            transform 0.25s ease;

          opacity: 1;
          transform: translateY(0);
        }

        .character-bg img.changing {
          opacity: 0;
          transform: scale(0.92);
        }

        .info.text-changing,
        .character-desc p.text-changing {
          opacity: 0;
          transform: translateY(10px);
        }

        @media (max-width: 1200px) {
          .character {
            height: auto;
            min-height: 100vh;
            padding: 3.5rem 0;
          }

          .selection-character {
            height: auto;
          }

          .character-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: auto; /* ✅ Que crezca con contenido */
            width: 100% !important;
            transform: skew(0);
            border: none;
          }

          .info-character {
            height: auto;
            min-height: 50vh; /* ✅ Dale altura mínima */
            width: 100%;
          }

          .character-image {
            height: auto;
            min-height: 50vh;
            max-height: 80vh;
            width: 100%;
            transform: scale(1);
          }

          .character-main {
            height: 100%; /* ✅ Ahora hereda de info-character correctamente */
          }

          .character-main::before {
            border: none;
          }

          .character-bg {
            height: 100%; /* ✅ Importante */
            width: 100%;
          }

          .character-grid-selection {
            grid-template-columns: repeat(3, 160px);
            grid-template-rows: repeat(3, 160px);
          }
        }

        @media (max-width: 660px) {
          .character-container {
            gap: 1rem;
            border: none;
          }
          .character-grid-selection {
            grid-template-columns: repeat(3, 140px);
            grid-template-rows: repeat(3, 140px);
          }

          .character-stats {
            width: 100%;
            /* grid-column: 1 / 6; */
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            margin-left: 0.7rem;
          }

          svg {
            height: 30px;
            width: 30px;
          }

          .character-bg {
            display: flex;
            flex-direction: column-reverse;
            width: 100%;
            padding: 1rem;
          }

          .character-main::before {
            border: none;
            display: none;
          }
        }

        @media (max-width: 500px) {
          /* .character {
            height: 70%;
          } */

          .character-main {
            min-height: auto; /* ✅ Deja que se adapte */
            height: auto;
          }

          .character-stats {
            /* grid-column: 1 / 10; */
            /* grid-template-rows: repeat(5, 1fr); */
          }

          .character-info-name {
            justify-content: end;
          }

          .character-info-name .section-title {
            font-size: 1.6rem;
            filter: drop-shadow(1px 2px 3px #000000);
          }

          .character-info-name span {
            filter: drop-shadow(1px 2px 1px #000000);
          }

          .character-image {
            height: auto; /* ✅ No fuerces height */
            max-height: 60vh;
            grid-column: 1 / 10;
            grid-row: 1 / 4;
            transform: scale(1);
          }

          .character-image::after {
            background-position: top;
          }

          .character-image img {
            object-position: top;
          }

          .category-info {
            height: auto;
            align-items: center;
          }

          .category-info .info {
            font-size: 11px;
            text-align: center;
          }

          .character-info-name {
            /* grid-column: 1 / 3; */
            /* grid-row: 2; */
          }

          .selection-character {
            padding: 0rem;
          }

          svg {
            height: 20px;
            width: 20px;
          }

          .selection-title h2 {
            font-size: 2.5rem;
          }

          .character-info {
            flex-direction: row;
            /* grid-column: 1 / 4; */
            /* grid-row: 3 / 4; */
            gap: 0.5rem;
            max-width: none;
            padding: 0.5rem;
            min-height: 60px;
            /* display: none; */
          }

          .character-origin {
            width: 33%;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-bottom: none;
          }

          .character-origin .icon {
            height: auto;
          }

          .character-description {
            /* grid-column: 1 / 4; */
            /* grid-row: 4 / 6; */
            min-height: 80px;
            height: max-content;
            max-width: none;
          }

          .character-grid-selection {
            grid-template-columns: repeat(3, 100px);
            grid-template-rows: repeat(3, 100px);
          }

          .info-character {
            min-height: auto; /* ✅ Flexible en móvil pequeño */
          }

          .character-main {
            min-height: auto;
          }

          .character-bg {
            min-height: auto;
            height: auto;
          }

          .character-image {
            height: auto;
          }
        }
      </style>
    </div>
  </div>
  <script define:vars={{ characters, crawlerInfo, physicalTraits }}>
    let active = document.querySelector(".character-card.active");

    const titleSection = document.querySelector(
      ".section-title[data-key='name_character']",
    );
    const titleAliase = document.querySelector(
      ".character-info-name span[data-key='aliase_character']",
    );
    const characterBg = document.querySelector(".character-image img");
    const characterDesc = document.querySelector(".character-description p");
    const characterOrigin = document.querySelector("#origin p[data-key]");
    const characterJob = document.querySelector("#job p[data-key]");
    const characterId = document.querySelector("#id_crawler p[data-key]");

    const characterGridSelection = document.querySelector(
      ".character-grid-selection",
    );

    function preloadCharacterImages() {
      Object.values(characters).forEach((character) => {
        const img = new Image();
        img.src = character.img + ".avif";
      });
    }

    preloadCharacterImages();
    characterGridSelection.addEventListener("click", (e) => {
      if (e.target.closest(".character-card")) {
        const id = e.target.dataset.id;
        const character = characters[id];
        characterBg.classList.add("changing");
        characterOrigin.classList.add("text-changing");
        characterJob.classList.add("text-changing");
        characterId.classList.add("text-changing");
        characterDesc.classList.add("text-changing");

        e.target.classList.add("active");
        if (active) {
          active.classList.remove("active");
        }
        active = e.target;

        setTimeout(() => {
          characterBg.src = character.img + ".avif";

          titleSection.textContent = character.name;
          titleAliase.textContent = character.aliase;
          characterOrigin.textContent = character.crawler_info.origin;
          characterJob.textContent = character.crawler_info.job;
          characterId.textContent = character.crawler_info.crawler_number;
          characterDesc.textContent = character.description;
          characterBg.classList.remove("changing");
          characterOrigin.classList.remove("text-changing");
          characterJob.classList.remove("text-changing");
          characterId.classList.remove("text-changing");
          characterDesc.classList.remove("text-changing");
        }, 250);
      }
    });

    characterBg.src = characters[1].img + ".avif";
  </script>
</section>
