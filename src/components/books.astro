---
import { booksContet } from "../const/books";
import svgTop from "../assets/layered-peaks-top2.svg";
import svgBottom from "../assets/layered-peaks-bottom2.svg";

// const books = [
//   { id: 1, title: "Book 1", col: 1 },
//   { id: 2, title: "Book 2", col: 2, parent: 1 },
//   { id: 3, title: "Book 3", col: 3, parent: 2 },
//   { id: 4, title: "Book 4", col: 2, parent: 1 },
// ];
---

<section
  class="books"
  style={`--svg-top: url(${svgTop.src}); --svg-bottom: url(${svgBottom.src});`}
>
  <div class="books-container section">
    <div class="book-info">
      <div class="book-info-img">
        <img src="/books/book7-3d.avif" alt="" loading="lazy" />
      </div>
      <div class="book-info-content" id="book-info-card">
        <h2 class="title-section">A Parade Of Horribles</h2>
        <p class="text-info">
          It’s off to the races in the explosive 8th book in the Dungeon Crawler
          Carl series!
        </p>
        <p class="text-description">
          As chaos and mass panic spread outside the dungeon in the wake of
          Faction Wars, Carl and Donut find themselves on the tenth floor, where
          they’re forced to compete in a surprisingly normal set of tasks. Well,
          normal for the dungeon. Races. Get from point A to point B, and don’t
          come in last. After each race, they pick an upgrade for their vehicle
          and the track gets more challenging. It all seems a little too normal,
          a little too simple.
        </p>
        <div class="links">
          <button class="btn-buy"
            >EBOOK
            <span class="btn-buy-corner"></span>
          </button>
          <button class="btn-buy">BOOK</button>
        </div>
      </div>
    </div>

    <div class="books-list" id="book-list-info">
      <h2 class="title-section">BOOKS</h2>
      <div class="book-cards">
        {
          booksContet.map((book) => {
            return (
              <div
                class={`book-item ${book.id === 1 ? " active" : ""}`}
                data-id={book.id}
              >
                <div class="button-active">
                  <div class="point" />
                </div>
                <div class="book-item-content">
                  <div class="book-img">
                    <img src={book.image} alt="Image-book" loading="lazy" />
                  </div>
                  <div class="book-desc">
                    <p>{book.bookInfo}</p>
                    <h4>{book.title}</h4>
                  </div>
                  <span class="border border-top-left" />
                  <span class="border border-bottom-left" />
                  <span class="border border-top-right" />
                  <span class="border border-bottom-right" />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
  <style>
    .books {
      position: relative;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .books::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 150px;
      background-image: var(--svg-top);
      background-repeat: no-repeat;
      background-position: top;
      background-size: cover;
      pointer-events: none;
      z-index: 10;
    }

    .books::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 150px;
      background-image: var(--svg-bottom);
      background-repeat: no-repeat;
      background-position: bottom;
      background-size: cover;
      /* filter: drop-shadow(0 2px 5px rgb(0, 0, 0)); */
      pointer-events: none;
      z-index: 10;
    }

    .books-container {
      width: 1600px;
      height: 80vh;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
      /* animation: zoomIn linear both;
      animation-timeline: --section;
      animation-range: entry 10% cover 50%; */
    }

    h2 {
      opacity: 0;
      animation: breathe ease forwards;
      animation-timeline: --section;
      animation-range: entry 40%;
    }

    /* IZQUIERDA */
    .books-list {
      max-width: 40%;
      background: #26262656;
      border-radius: 12px;
      padding: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow-y: auto;
      height: 80%;
      opacity: 0;
      animation: slideB ease forwards;
      animation-timeline: --section;
      animation-range: entry 40%;
    }

    .book-cards {
      font-family: "Bebas Neue", sans-serif;
      margin-top: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: end;
    }

    /* ITEMS */
    .book-item {
      position: relative;
      width: 100%;
      display: flex;
      justify-content: flex-end;
    }

    .point {
      position: absolute;
      left: 10px;
      top: 12px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      display: flex;
      background-color: #b10756;
      box-shadow: 0 0 6px #b10756;
      justify-content: center;
      align-items: center;
      z-index: 0;
      transition: background-color 0.3s ease;
    }

    .book-item::after {
      position: absolute;
      content: "";
      left: 15px;
      top: 24px;
      width: 2px;
      height: 100%;
      background-color: #b10756;
      box-shadow: 0 0 6px #b10756;
      opacity: 0.8;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: -1;
      transition: background-color 0.3s ease;
    }

    .book-item:last-child::after {
      display: none;
    }

    .book-item.active ~ .book-item .point,
    .book-item.active ~ .book-item::after,
    .book-item.active::after {
      background-color: #4d0118;
      box-shadow: none;
    }

    .book-item-content {
      position: relative;
      display: flex;
      align-items: center;
      padding: 12px;
      margin-bottom: 10px;
      border-radius: 8px;
      height: 100px;
      color: #eae0c2;
      cursor: pointer;
      width: 90%;
      /* transition: 0.2s; */
    }

    .book-img {
      width: 80px;
      height: 100%;
      border-radius: 8px;
      overflow: hidden;
    }

    .book-img img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .book-desc p {
      font-size: 1rem;
      color: #9b9582;
    }

    .book-desc h4 {
      font-size: 1.2rem;
    }

    .book-item-content:hover {
      transform: translateX(4px);
    }

    /* DERECHA */
    .book-info {
      position: relative;
      flex: 1;
      display: flex;
      align-items: center;
      height: max-content;
      width: 100%;
      border-radius: 12px;
      color: #ffffff;
      padding: 30px;
      opacity: 0;
      animation: slideA ease forwards;
      animation-timeline: --section;
      animation-range: entry 40%;
    }

    .book-info-img {
      flex: 2;
      width: 20%;
    }

    .book-info-img img {
      width: 80%;
      object-fit: contain;
      opacity: 0.8;
      filter: drop-shadow(0 2px 6px rgb(209, 204, 204));
    }

    .book-info-content {
      flex: 3;
      height: 90%;
      gap: 1rem;
      display: flex;
      flex-direction: column;
      justify-content: start;
    }

    .book-info-content p {
      font-family: "Inter", sans-serif;
      font-size: var(--font-size-text);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.85);
      max-width: 65ch;
      text-wrap: pretty;
    }

    .book-info::after {
      position: absolute;
      content: "";
      inset: 0;
      background: #420f3c56;
      background-image: url("/books/dots-50.png");
      background-repeat: no-repeat;
      background-size: cover;
      border-radius: 12px;
      padding: 20px;
      border: 1px solid rgba(79, 76, 76, 0.518);
      z-index: -1;
    }

    .book-info::before {
      position: absolute;
      content: "";
      inset: 0;
      background-image: var(--bg-image);
      background-repeat: no-repeat;
      background-size: cover;
      z-index: -10;
      opacity: 0.1;
      transition: opacity 0.5s ease;
    }

    .book-info.book-change::before {
      opacity: 0;
    }

    .book-info-content h2 {
      text-align: left;
      min-height: 120px;
    }

    .text-info {
      min-height: 80px;
    }

    .text-description {
      min-height: max-content;
    }

    .text-description,
    .text-info,
    .title-section,
    .book-info-img {
      transition:
        opacity 0.5s,
        transform 0.5s;
      opacity: 1;
      transform: translateX(0);
    }

    .text-description.book-change,
    .text-info.book-change,
    .title-section.book-change,
    .book-info-img.book-change {
      opacity: 0;
      transform: translateX(20px);
    }

    .book-item-content {
      content-visibility: auto;
    }

    .book-info {
      content-visibility: auto;
    }

    /* @media (max-width: 1200px) {
      .books-list {
        max-width: 420px;
      }
    } */

    @media (max-width: 1100px) {
      .books {
        height: auto;
        min-height: 100vh;
        width: 100%;
        padding: 3.5rem 0;
      }

      /* ← AÑADE ESTO */
      h2,
      .books-list,
      .book-info {
        animation-timeline: auto !important;
      }
      /* ← FIN */

      .books-container {
        flex-direction: column-reverse;
        height: 80%;
        width: 100%;
      }

      .books-list {
        max-width: 90%;
        margin-bottom: 2rem;
      }

      .book-cards {
        width: 100%;
        flex-direction: row;
        justify-content: left;
        height: 150px;
        gap: 1rem;
        overflow-x: scroll;
        overflow-y: hidden;
        padding: 0.5rem 0;
      }

      .book-item::after {
        height: 2px;
        width: calc(100% + 1rem);
        top: -25px;
        left: 50%;
      }

      .book-item {
        width: 100%;
        height: 100px;
      }

      .point {
        top: -30px;
        left: 50%;
        /* transform: translateX(50%); */
      }

      .book-item-content {
        width: 340px;
        height: 100px;
      }

      .book-info {
        width: 100%;
        flex-direction: column;
      }

      .book-info {
        width: 90%;
      }

      .book-info-img {
        width: 40%;
        justify-content: center;
        margin-bottom: 2rem;
      }

      .book-info-img img {
        width: 100%;
        object-position: center;
      }

      .book-info-content h2 {
        min-height: 60px;
      }

      .text-info {
        min-height: 40px;
      }

      .book-info-content {
      }
    }
  </style>
  <script define:vars={{ booksContet }}>
    let timeoutId;
    let currentBookId;
    const bookContent = document.querySelector("#book-info-card");
    const bookImage = document.querySelector(".book-info-img img");
    const bookList = document.querySelectorAll(".book-item");
    const bookListContainer = document.querySelector("#book-list-info");
    const bookInfo = document.querySelector(".book-info");
    let activeBook = document.querySelector(".book-item.active");

    const elementsToAnimate = {
      title: bookContent.querySelector("h2"),
      textInfo: bookContent.querySelector(".text-info"),
      textDesc: bookContent.querySelector(".text-description"),
      bookImg: document.querySelector(".book-info-img"),
      bookInfoCard: document.querySelector(".book-info"),
    };

    // ✅ CACHÉ EN MEMORIA (las imágenes ya cargadas viven aquí)
    const imageCache = {};
    const loadedImages = new Set(); // ← Trackea cuáles ya se cargaron

    function preloadImages() {
      console.log("Preloading images...");
      booksContet.forEach((book) => {
        const url = book.imageCover || book.image;
        console.log("Precargando:", url);

        // ✅ Solo precarga UNA VEZ
        if (!loadedImages.has(url)) {
          const img = new Image();
          img.addEventListener("load", () => {
            imageCache[book.id] = url;
            loadedImages.add(url);
          });
          img.src = url;
        } else {
          console.log("La imagen ya estaba precargada:", url);
        }
      });
    }

    function changeBook(book, card) {
      Object.values(elementsToAnimate).forEach((el) => {
        el.classList.add("book-change");
      });

      setTimeout(() => {
        // ✅ Cambia src SIN hacer nueva request
        bookImage.src = imageCache[book.id];

        elementsToAnimate.title.textContent = book.title;
        elementsToAnimate.textInfo.textContent = book.introduction;
        elementsToAnimate.textDesc.textContent = book.description;
        bookInfo.style.setProperty("--bg-image", `url(${imageCache[book.id]})`);

        Object.values(elementsToAnimate).forEach((el) => {
          el.classList.remove("book-change");
        });

        activeBook.classList.remove("active");
        card.classList.add("active");
        activeBook = card;
      }, 150);
    }

    bookList.forEach((item) => {
      item.addEventListener("mouseenter", (e) => {
        const card = e.target.closest(".book-item");
        if (!card) return;

        const bookId = card.dataset.id;
        const book = booksContet.find((b) => b.id == bookId);
        currentBookId = bookId;

        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
          if (currentBookId !== bookId) return;
          changeBook(book, card);
        }, 150);
      });
    });

    bookListContainer.addEventListener("click", (e) => {
      const card = e.target.closest(".book-item");
      if (!card) return;

      const bookId = card.dataset.id;
      const book = booksContet.find((b) => b.id == bookId);

      elementsToAnimate.title.textContent = book.title;
      elementsToAnimate.textInfo.textContent = book.introduction;
      elementsToAnimate.textDesc.textContent = book.description;
      bookImage.src = imageCache[book.id];
      bookInfo.style.setProperty("--bg-image", `url(${imageCache[book.id]})`);
    });

    // ✅ PRECARGA AL FINAL
    preloadImages();
  </script>
</section>
