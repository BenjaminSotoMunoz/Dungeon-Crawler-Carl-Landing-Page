---
import svgTop from "../assets/layered-peaks-top.svg";
import svgBottom from "../assets/layered-peaks-bottom.svg";
---

<section class="hero" style={`--svg-top: url(${svgTop.src}); --svg-bottom: url(${svgBottom.src});`}>
  <div class="character-container"></div>
  <div class="hero-content">
    <div class="hero-left">
      <h1 class="hero-title">
        <span>THE</span><br />
        <span>DUNGEON</span><br />
        <span>CRAWLER</span><br />
        <span>CARL</span><br />
        <span>SAGA</span>
      </h1>
    </div>
    <div class="hero-right">
      <div class="books-container">
        <img src="/books/book.avif" class="book" alt="Book Cover" />
        <img src="/books/book2.avif" class="book" alt="Book Cover" />
        <img src="/books/book3.avif" class="book" alt="Book Cover" />
        <img src="/books/book4.avif" class="book" alt="Book Cover" />
        <img src="/books/book5.avif" class="book" alt="Book Cover" />
        <img src="/books/book6.avif" class="book" alt="Book Cover" />
        <img src="/books/book7.avif" class="book" alt="Book Cover" />
        <img src="/books/donut.avif" class="hero-donut" alt="Book Cover" />
      </div>
    </div>
  </div>
</section>
<style>
  body {
    background-color: rgb(16, 16, 16);
    height: 200vh;
  }

  body::before {
    content: "";
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    position: fixed;
    /* Set the size of each grid square */
    background-size: 40px 40px;

    /* Draw vertical and horizontal lines */
    background-image: radial-gradient(circle, #e0bb263e 1px, transparent 1px);
    z-index: -1;
  }

  section {
    min-height: 100vh;
    width: 100%;
  }

  .hero-title {
    animation: textFloat 1s ease-in-out;
  }

  .hero-content {
    /* position: relative; */
    width: 100%;
    min-height: 100vh;
    /* margin: 0 auto; */
    /* z-index: 1; */
  }

  .books-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-content::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 400px;
    background-image: var(--svg-bottom);
    background-repeat: no-repeat;
    background-position: bottom;
    background-size: cover;
    filter: drop-shadow(0 2px 10px rgb(1, 1, 1));
    pointer-events: none;
    animation: bgFade 0.5s ease-in-out;
    z-index: 10;
  }

  .hero-content::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 300px;
    background-image: var(--svg-top);
    background-repeat: no-repeat;
    background-position: top;
    background-size: cover;
    filter: drop-shadow(0 2px 10px rgb(1, 1, 1));
    pointer-events: none;
    animation: bgFade 0.5s ease-in-out;
    z-index: 10;
  }

  .book {
    position: absolute;
    width: min(200px, 100%);
    animation: float 1s ease-in-out both, floatInfinite 4s ease-in-out infinite;
    

  }

  .book + .book {
    margin-left: -40px;
  }
  .book:nth-child(1) {
    top: 8%;
    left: 25%;
    --rotation: -8deg;
    animation-delay: 0.2s;
    
    z-index: 1;
  }

  .book:nth-child(2) {
    top: 25%;
    left: 10%;
    --rotation: -15deg;
    animation-delay: 1s;
    z-index: 2;
  }

  .book:nth-child(3) {
    top: 25%;
    left: 40%;
    --rotation: 8deg;
    animation-delay: 0.6s;
    z-index: 2;
  }

  .book:nth-child(4) {
    top: 45%;
    left: 20%;
    --rotation: -6deg;
    animation-delay: 0.3s;

    z-index: 3;
  }

  .book:nth-child(5) {
    top: 48%;
    left: 45%;
    --rotation: 10deg;
    animation-delay: 0.8s;

    z-index: 3;
  }

  .book:nth-child(6) {
    top: 55%;
    left: 70%;
    --rotation: 10deg;
    animation-delay: 1s;

    z-index: 4;
  }
  .book:nth-child(7) {
    top: 55%;
    left: 0;
    --rotation: -10deg;
    animation-delay: 0.4s;

    z-index: 4;
  }

  .hero-donut {
    position: absolute;
    bottom: 0;
    left: 20%;
    width: min(350px, 100%);
    /* transform: translateX(-50%); */
    z-index: 9;
    filter: drop-shadow(-20px 1px 20px rgb(1, 1, 1));
    --rotation: 0deg;
    margin-left: 0 !important;
  }

  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 110%;
    height: 100%;
    background-image: url("/books/rays.webp");
    background-size: contain;
    /* background-position: ; */
    background-repeat: no-repeat;
    filter: brightness(0.7) contrast(1.2) saturate(1.2);
    animation: bgFade 2s ease-in-out;
    z-index: -1;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;

    min-height: 100vh;
    width: min(1400px, 100%);
    margin: 0 auto;
    padding-inline: 4rem;
    gap: 3rem;
  }

  .hero-left {
    display: flex;
    align-items: center;
  }

  .hero-right {
    display: grid;
  }

  .hero-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(4.5rem, 9vw, 7rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0px;
    color: #f2c14d;
    letter-spacing: 3px;
    line-height: 0.85;

    text-shadow:
      4px 4px 0 #7c1c1c,
      8px 8px 0 rgba(0, 0, 0, 0.4);

    transform: skew(-2deg);
    filter: contrast(1.15) saturate(1.2);
  }

@media (max-width: 1100px) {
  .hero::before {
    background-size: cover;
  }

  .hero-content {
    grid-template-columns: 1.5fr 1fr;
    padding-inline: 2rem;
  }

  .hero-left {
    min-height: 300px;
    justify-content: center;
    text-align: center;
  }
}

@media (max-width: 935px) {
  .hero::before {
    background-image: none;
  }

  .hero-content {
    display: flex;
    height: auto;
    /* min-height: 100vh; */
    flex-direction: column;
    justify-content: space-around;
    padding: 2rem;
  }

  .hero-content::before {
    height: 70%;
  }

  .hero-content::after {
    height: 70%;
  }

  .hero-left,
  .hero-right {
    flex: 1;
  }

  .hero-right {
    display: flex;
    justify-content: center;
    align-items: end;
  }

  .books-container {
    position: relative;
    display: flex;
    /* flex-wrap: wrap; */
    justify-content: center;
    height: 100%;
  }

  .book {
    position: static;
    object-fit: contain;
    width: min(150px, 100%);
    height: 140px;
  }

  .hero-donut {
    position: absolute;
    /* width: min(190px, 100%); */
    object-fit: contain;
    /* height: auto; */
    bottom: -50px;
    left: 50%;
    transform: translateX(-50%);
    animation: none;
    z-index: 5;
  }

}

@media (max-width: 500px) {
  .hero-title {
    font-size: clamp(3.5rem, 9vw, 7rem);
  }
  
}

  @keyframes float {
    0%{
      opacity: 0;
      transform: rotate(var(--rotation)) translateY(0px);
    }
    100% {
      opacity: 1;
      transform: rotate(var(--rotation)) translateY(0px);
    }

    50% {
      opacity: .5;
      transform: rotate(var(--rotation)) translateY(-10px);
    }
  }

  @keyframes floatInfinite {
    0% {
      transform: rotate(var(--rotation)) translateY(0px);
    }
    100% {
      transform: rotate(var(--rotation)) translateY(0px);
    }

    50% {
      transform: rotate(var(--rotation)) translateY(-10px);
    }
  }

  @keyframes bgFade {
    0% {
      opacity: 0.3;
    }

    100% {
      opacity: 1;
    }
  }

  @keyframes textFloat {
    0% {
      opacity: 0;
      transform: translateY(-10px) skew(0deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) skew(-2deg);
    }
</style>
